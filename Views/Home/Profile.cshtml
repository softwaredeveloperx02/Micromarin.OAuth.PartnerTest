@model Micromarin.OAuth.PartnerTest.Models.UserProfileVm
@{
    Layout = "~/Views/Shared/_LayoutAuth.cshtml";
    ViewData["Title"] = "Profile";
}

<style>
    .profile-bg {
        min-height: calc(100vh - 80px);
        background: linear-gradient(135deg, #0d3b66 0%, #0069F3 50%, #00b4d8 100%);
        padding: 64px 16px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .profile-card {
        background: #fff;
        border-radius: 20px;
        max-width: 460px;
        width: 100%;
        box-shadow: 0 25px 60px rgba(13, 59, 102, 0.35);
        overflow: hidden;
        animation: fadeUp 0.4s ease-out;
    }

    @@keyframes fadeUp {
        from { opacity: 0; transform: translateY(15px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .profile-card__hero {
        background: linear-gradient(135deg, #0069F3 0%, #00b4d8 100%);
        padding: 40px 24px 88px;
        text-align: center;
        color: #fff;
        position: relative;
    }

    .profile-card__source {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 12px;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.18);
        backdrop-filter: blur(6px);
    }

    .profile-card__avatar {
        width: 110px;
        height: 110px;
        border-radius: 50%;
        background: #fff;
        color: #0069F3;
        font-size: 42px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
        position: absolute;
        bottom: -55px;
        left: 50%;
        transform: translateX(-50%);
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.18);
        border: 5px solid #fff;
    }

    .profile-card__body {
        padding: 72px 32px 32px;
        text-align: center;
    }

    .profile-card__name {
        font-size: 24px;
        font-weight: 700;
        color: #102a43;
        margin: 0 0 4px;
    }

    .profile-card__company {
        font-size: 14px;
        color: #486581;
        margin: 0 0 24px;
    }

    .profile-card__details {
        list-style: none;
        padding: 0;
        margin: 0 0 24px;
        text-align: left;
        border-top: 1px solid #e2e8f0;
    }

    .profile-card__details li {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 14px 4px;
        border-bottom: 1px solid #e2e8f0;
        font-size: 14px;
    }

    .profile-card__details .label {
        color: #627d98;
        font-weight: 500;
    }

    .profile-card__details .value {
        color: #102a43;
        font-weight: 600;
        text-align: right;
        word-break: break-word;
        max-width: 260px;
    }

    .profile-card__actions {
        display: flex;
        gap: 10px;
    }

    .profile-card__actions .btn {
        flex: 1;
        font-weight: 600;
        padding: 11px 14px;
        border-radius: 10px;
    }

    .btn-outline-primary-soft {
        color: #0069F3;
        background: #eaf2ff;
        border: 1px solid transparent;
    }

    .btn-outline-primary-soft:hover {
        background: #d6e4ff;
        color: #0050c2;
    }

    .btn-danger-soft {
        background: #fde2e2;
        color: #b42318;
        border: 1px solid transparent;
    }

    .btn-danger-soft:hover {
        background: #f9c0c0;
        color: #8a1313;
    }
</style>

<div class="profile-bg">
    <div class="profile-card">
        <div class="profile-card__hero">
            <span class="profile-card__source">
                <i class="fas fa-shield-alt"></i> @Model.LoginSource
            </span>
            <div class="profile-card__avatar">@Model.Initials</div>
        </div>

        <div class="profile-card__body">
            <h1 class="profile-card__name">@(string.IsNullOrWhiteSpace(Model.FullName) ? "User" : Model.FullName)</h1>
            <p class="profile-card__company">@Model.CompanyName</p>

            <ul class="profile-card__details">
                <li>
                    <span class="label">First name</span>
                    <span class="value">@Model.FirstName</span>
                </li>
                <li>
                    <span class="label">Last name</span>
                    <span class="value">@Model.LastName</span>
                </li>
                @if (!string.IsNullOrWhiteSpace(Model.UserName))
                {
                    <li>
                        <span class="label">Username</span>
                        <span class="value">@Model.UserName</span>
                    </li>
                }
                <li>
                    <span class="label">Company</span>
                    <span class="value">@Model.CompanyName</span>
                </li>
                @if (!string.IsNullOrWhiteSpace(Model.CompanyTitle))
                {
                    <li>
                        <span class="label">Job title</span>
                        <span class="value">@Model.CompanyTitle</span>
                    </li>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Email))
                {
                    <li>
                        <span class="label">Email</span>
                        <span class="value">@Model.Email</span>
                    </li>
                }
                @if (!string.IsNullOrWhiteSpace(Model.PartnerSub))
                {
                    <li>
                        <span class="label" title="Opaque partner-specific subject issued by Micromarin. This is not the internal AccountID GUID; values differ per partner client.">Partner Sub</span>
                        <span class="value" style="font-family:monospace; font-size:12px;">@Model.PartnerSub</span>
                    </li>
                }
            </ul>

            <div class="profile-card__actions">
                <a class="btn btn-outline-primary-soft" href="/">
                    <i class="fas fa-home me-1"></i> Home
                </a>
                <form asp-action="Logout" asp-controller="Home" method="post" class="d-inline" style="flex:1;">
                    <button type="submit" class="btn btn-danger-soft w-100">
                        <i class="fas fa-sign-out-alt me-1"></i> Sign out
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
