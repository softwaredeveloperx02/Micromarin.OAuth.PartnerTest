@{
    Layout = "~/Views/Shared/_LayoutAuth.cshtml";
    ViewData["Title"] = "Login";
}

<div id="app">
    <nav class="navbar navbar-expand-lg mm-main-navbar">
        <a href="/" class="navbar-brand offset-xl-1 offset-0">
            <img class="mm-navbar-img" src="https://support.mathreex.com/uploads/3/Mathreex-Logo-Full-Dark.png" alt="logo not found" />
        </a>
        <button class="navbar-toggler collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
                aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
            <i class="fas fa-bars"></i>
        </button>
        <div class="navbar-collapse collapse" id="navbarSupportedContent">
            <ul class="navbar-nav navbar-right ms-auto align-items-center">
                <li class="nav-item">
                    <a href="/" class="nav-link"><i class="fas fa-home pe-1"></i><span>Home</span></a>
                </li>
                <li class="nav-item">
                    <a href="#" class="nav-link"><i class="fas fa-question-circle pe-1"></i><span>FAQs</span></a>
                </li>
                <li class="nav-item active">
                    <a href="#" class="nav-link"><i class="fas fa-sign-in-alt pe-1"></i><span>Login</span></a>
                </li>
            </ul>
        </div>
    </nav>

    <div class="mt-0">
        <div class="main-section-area">
            <div class="container pt-5">
                <div class="row justify-content-center large-card shadow mm-login-wrap">
                    <div class="col-md-6 pr-0 d-flex justify-content-center align-items-center p-0">
                        <img src="https://support.mathreex.com/theme-assets/img/login.jpg" class="w-100 mm-login-side" alt="login visual" />
                    </div>
                    <div class="col-md-6 pl-0 p-4 p-md-3">
                        <h1 class="display-4 display-sm-2 mt-3 font-weight-bold text-center">Login</h1>
                        <div class="d-flex justify-content-center align-items-center mt-md-4 mt-3">
                            <form class="web-user-form w-100 px-2 px-md-4" asp-action="DemoLogin" asp-controller="Home" method="post" novalidate>
                                @if (TempData["LoginError"] is string loginError && !string.IsNullOrWhiteSpace(loginError))
                                {
                                    <div class="alert alert-danger py-2" role="alert">@loginError</div>
                                }
                                <div class="form-group mb-3">
                                    <label class="ml-1" for="email">Email</label>
                                    <input id="email" name="email" type="text" class="form-control" placeholder="Enter Email" tabindex="1" required />
                                </div>
                                <div class="form-group mb-3">
                                    <label class="ml-1" for="password">Password</label>
                                    <input id="password" name="password" type="password" class="form-control" placeholder="Enter Password" tabindex="2" required />
                                </div>
                                <div class="form-group ml-1 mb-3">
                                    <div class="custom-control custom-checkbox">
                                        <input type="checkbox" class="custom-control-input" tabindex="3" id="remember" />
                                        <label class="custom-control-label" for="remember">Remember Me</label>
                                    </div>
                                </div>
                                <div class="form-group mb-2">
                                    <button type="submit" class="btn btn-primary btn-lg btn-block btn-submit w-100" tabindex="4">Login</button>
                                </div>
                                <div class="form-group social-login-buttons row mt-2">
                                    <div class="col-12">
                                        <a class="btn btn-mm-micromarin w-100" href="/login/micromarin">Login with Micromarin</a>
                                    </div>
                                </div>
                                <div class="form-group text-end mt-3 mb-0">
                                    <a href="#" class="text-small">Forgot Password?</a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="footer-section mt-4">
            <div class="justify-content-center footer-container">
                <div class="footer-img-left d-none d-md-block" style="background-image: url('https://support.mathreex.com/theme-assets/img/customer-support-footer.png');"></div>
                <div class="footer-img-right d-none d-md-block" style="background-image: url('https://support.mathreex.com/theme-assets/img/customer-support-footer(2).jpg');"></div>
                <div class="row justify-content-around">
                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-12 col-12 footer-logo">
                        <img src="https://support.mathreex.com/uploads/3/Mathreex-Logo-Full-Dark.png" alt="logo not found">
                        <p class="mt-3">All Rights Reserved &copy; 2026 Mathreex Support Center</p>
                    </div>
                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-12 col-12 text-md-left text-center">
                        <h3 class="footer-subsection-title">About Us</h3>
                        <p class="footer-subsection-text">Mathreex LMS is an innovative platform that provides employees and external audiences with blended learning.</p>
                    </div>
                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-12 col-12 text-md-left text-center">
                        <h3 class="footer-subsection-title">Contact Us</h3>
                        <p class="footer-subsection-list">Greece, Galaxias Building 4A Floor 6 Skouze Str. Pireaus 18536</p>
                        <p class="mb-2">Email: <a href="mailto:support@mathreex.com" class="text-decoration-none">support@mathreex.com</a></p>
                        <p class="mb-0">Phone: <a href="tel:+302104286552" class="text-decoration-none">+30 2104286552</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
