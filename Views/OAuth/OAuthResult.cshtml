@model Micromarin.OAuth.PartnerTest.Controllers.OAuthResultVm
@{
    ViewData["Title"] = Model.Success ? "Sign-in succeeded" : "Sign-in failed";
}

<div class="container py-5">
    <h1>@ViewData["Title"]</h1>
    <p class="@(Model.Success ? "text-success" : "text-danger") fw-semibold">@Model.Message</p>
    <a class="btn btn-outline-secondary" href="/">Home</a>
</div>
